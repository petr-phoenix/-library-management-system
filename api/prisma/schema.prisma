datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PATRON)
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("genres")
}

model Book {
  id              String   @id @default(uuid())
  title           String
  isbn            String   @unique
  author          String
  publishedYear   Int
  copiesAvailable Int      @default(1)
  genreId         String
  genre           Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  reviews         Review[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([genreId])
  @@map("books")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId]) // Enforces one review per patron per book
  @@index([bookId])
  @@index([userId])
  @@map("reviews")
}
